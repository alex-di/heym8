{
  "name": "heymate-front",
  "version": "1.0.0",
  "repository": "git@github.com:alex-di/serverless-webrtc.git",
  "author": "Diakov, Aleksei <mm77707@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "yarn install && yarn compile && yarn tsc",
    "clean": "yarn hardhat clean && rm -rf dist",
    "compile": "yarn run hardhat compile --force",
    "verify": "yarn run hardhat etherscan-verify",
    "deploy": "yarn run hardhat deploy",
    "test": "yarn run hardhat test",
    "format": "prettier --write '*/**/*.*{js,json,md,ts}'",
    "format:check": "prettier --check '*/**/*.*{js,json,md,ts}'",
    "lint": "eslint --cache . && yarn lint:sol",
    "lint:ts": "eslint -c .eslintrc.json --ext \"**/*.ts\" \"**/*.test.ts\"",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "postinstall": "yarn husky install",
    "dev": "parcel src/index.html",
    "build:front": "parcel build src/index.html --public-url ./"
  },
  "lint-staged": {
    "*.*{js,json,md,ts,sol,yml,yaml}": "prettier --write",
    "*.*{ts,js}": "eslint -c .eslintrc.json"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.12.0",
    "@tsconfig/recommended": "^1.0.7",
    "@types/chai": "4.3.5",
    "@types/mocha": "10.0.1",
    "@types/node": "^14.18.63",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "5.60.0",
    "@typescript-eslint/parser": "5.60.0",
    "buffer": "^6.0.3",
    "chai": "4.3.7",
    "dotenv": "16.3.1",
    "eslint": "8.43.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier": "4.2.1",
    "events": "^3.3.0",
    "husky": "8.0.3",
    "lint-staged": "13.2.2",
    "parcel": "^2.12.0",
    "prettier": "2.8.8",
    "prettier-plugin-solidity": "1.1.3",
    "process": "^0.11.10",
    "sass": "^1.79.4",
    "solhint": "3.4.1",
    "solhint-plugin-prettier": "0.0.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@xstate/react": "^3.2.2",
    "ethers": "^6.13.3",
    "idb": "^8.0.0",
    "react": "^17.0.1",
    "react-bootstrap": "^2.10.5",
    "react-bootstrap-icons": "^1.11.4",
    "react-dom": "^17.0.2",
    "react-router-dom": "^6.26.2",
    "rxjs": "^7.8.1",
    "socket.io-client": "^4.8.0",
    "webrtc-adapter": "^7.7.1",
    "websocket": "^1.0.35",
    "xstate": "^4.38.3"
  }
}
